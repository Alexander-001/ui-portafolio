---
interface Props {
  title: string;
  project: string;
  description: string;
  date: string;
  link?: string;
  messageLink?: string;
}
const { title, project, description, link, messageLink, date } = Astro.props;
---

<div class="exp-card">
  <span class="date-badge">{date}</span>

  <h3 class="mt-3 text-lg md:text-xl font-bold text-white leading-snug">
    {title}
  </h3>

  <p class="mt-1 text-violet-400 font-semibold text-sm md:text-base">
    {project}
  </p>

  <p class="mt-3 text-white/60 text-sm md:text-base leading-relaxed">
    {description}
  </p>

  {
    link && (
      <a href={link} target="_blank" class="exp-link mt-5 inline-flex items-center gap-2">
        {messageLink ?? "Saber más"}
        <svg class="w-3 h-3" fill="none" viewBox="0 0 14 10" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M1 5h12m0 0L9 1m4 4L9 9" />
        </svg>
      </a>
    )
  }
</div>

<style>
  .exp-card {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 1rem;
    padding: 1.25rem 1.5rem;
    transition: background 0.25s, border-color 0.25s;
  }
  .exp-card:hover {
    background: rgba(255, 255, 255, 0.055);
    border-color: rgba(124, 58, 237, 0.3);
  }

  .date-badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 500;
    color: #a78bfa;
    background: rgba(124, 58, 237, 0.12);
    border: 1px solid rgba(124, 58, 237, 0.25);
    border-radius: 9999px;
    padding: 0.2rem 0.75rem;
  }

  .exp-link {
    font-size: 0.8rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.55);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 9999px;
    padding: 0.3rem 0.9rem;
    background: rgba(255, 255, 255, 0.04);
    transition: color 0.2s, background 0.2s, border-color 0.2s;
  }
  .exp-link:hover {
    color: white;
    background: rgba(255, 255, 255, 0.09);
    border-color: rgba(255, 255, 255, 0.2);
  }
</style>
