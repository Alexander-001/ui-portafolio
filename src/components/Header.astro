---

<header
  id="header"
  class="fixed top-0 left-0 z-50 flex justify-center items-center py-4 w-full"
>
  <nav
    id="nav"
    class="flex flex-row flex-wrap gap-x-0.5 md:gap-x-1 justify-center items-center px-2 py-2 bg-white/[0.04] backdrop-blur-xl border border-white/[0.09] rounded-full shadow-xl shadow-black/40"
  >
    <a href="#top"        class="nav-link">Inicio</a>
    <a href="#experience" class="nav-link">Experiencia</a>
    <a href="#about"          class="nav-link">Sobre mí</a>
    <a href="#projects"   class="nav-link">Proyectos</a>
    <a href="#knowledge"      class="nav-link">Conocimientos</a>
    <a href="#certifications" class="nav-link">Certificaciones</a>
    <a href="#contact"        class="nav-link">Contacto</a>
  </nav>
</header>

<style>
  .nav-link {
    color: rgba(255, 255, 255, 0.6);
    font-size: 0.875rem;
    padding: 0.375rem 0.875rem;
    border-radius: 9999px;
    transition: color 0.2s, background 0.2s;
    white-space: nowrap;
  }
  .nav-link:hover {
    color: white;
    background: rgba(255, 255, 255, 0.08);
  }
  .nav-link.active {
    color: white;
    background: rgba(124, 58, 237, 0.25);
    font-weight: 500;
  }
</style>

<script>
  const sections = [...document.querySelectorAll("section[id]")];
  const navLinks = document.querySelectorAll(".nav-link");

  function setActive(id: string) {
    navLinks.forEach((l) => l.classList.remove("active"));
    const link = document.querySelector(`a[href="#${id}"]`);
    if (link) link.classList.add("active");
  }

  function updateActive() {
    // At bottom of page → activate Contacto
    const nearBottom =
      window.innerHeight + window.scrollY >= document.body.offsetHeight - 80;
    if (nearBottom) {
      setActive("contact");
      return;
    }

    // Pick the last section whose top has passed 35% down the viewport
    const threshold = window.innerHeight * 0.35;
    let current = sections[0]?.id ?? "";
    for (const section of sections) {
      if (section.getBoundingClientRect().top <= threshold) {
        current = section.id;
      }
    }

    setActive(current);
  }

  window.addEventListener("scroll", updateActive, { passive: true });
  updateActive(); // highlight correct link on first load
</script>
