---
import AngularIcon from "../icons/Angular.astro";
import AstroIcon from "../icons/AstroIcon.astro";
import BootstrapIcon from "../icons/Bootstrap.astro";
import CopilotIcon from "../icons/Copilot.astro";
import CSSIcon from "../icons/Css.astro";
import GeminiIcon from "../icons/Gemini.astro";
import GithubIcon from "../icons/Github.astro";
import JavaIcon from "../icons/Java.astro";
import JavasScriptIcon from "../icons/JavaScript.astro";
import JenkinsIcon from "../icons/Jenkins.astro";
import MongoIcon from "../icons/Mongo.astro";
import MySqlIcon from "../icons/Mysql.astro";
import NextJSIcon from "../icons/NextJS.astro";
import NodeIcon from "../icons/Node.astro";
import OpenAIIcon from "../icons/OpenAI.astro";
import ReactIcon from "../icons/React.astro";
import SpringIcon from "../icons/Spring.astro";
import SqlIcon from "../icons/Sql.astro";
import TailwindIcon from "../icons/Tailwind.astro";
import TypeScriptIcon from "../icons/TypeScript.astro";
import VisualIcon from "../icons/Visual.astro";

const knowledges = [
  { name: "React",        icon: ReactIcon,       color: "rgba(96,165,250,0.18)",  border: "rgba(96,165,250,0.35)",  text: "#93c5fd" },
  { name: "React Native", icon: ReactIcon,       color: "rgba(59,130,246,0.18)", border: "rgba(59,130,246,0.35)",  text: "#93c5fd" },
  { name: "Next.js",      icon: NextJSIcon,      color: "rgba(255,255,255,0.07)",border: "rgba(255,255,255,0.15)", text: "#f1f5f9" },
  { name: "Angular",      icon: AngularIcon,     color: "rgba(239,68,68,0.18)",  border: "rgba(239,68,68,0.35)",   text: "#fca5a5" },
  { name: "TypeScript",   icon: TypeScriptIcon,  color: "rgba(99,102,241,0.18)", border: "rgba(99,102,241,0.35)",  text: "#a5b4fc" },
  { name: "JavaScript",   icon: JavasScriptIcon, color: "rgba(234,179,8,0.18)",  border: "rgba(234,179,8,0.35)",   text: "#fde047" },
  { name: "NodeJS",       icon: NodeIcon,        color: "rgba(74,222,128,0.15)", border: "rgba(74,222,128,0.3)",   text: "#86efac" },
  { name: "Java",         icon: JavaIcon,        color: "rgba(249,115,22,0.18)", border: "rgba(249,115,22,0.35)",  text: "#fdba74" },
  { name: "Spring Boot",  icon: SpringIcon,      color: "rgba(101,163,13,0.18)", border: "rgba(101,163,13,0.35)",  text: "#bef264" },
  { name: "Tailwind CSS", icon: TailwindIcon,    color: "rgba(14,165,233,0.18)", border: "rgba(14,165,233,0.32)",  text: "#7dd3fc" },
  { name: "Bootstrap",    icon: BootstrapIcon,   color: "rgba(139,92,246,0.18)", border: "rgba(139,92,246,0.35)",  text: "#c4b5fd" },
  { name: "CSS",          icon: CSSIcon,         color: "rgba(37,99,235,0.18)",  border: "rgba(37,99,235,0.35)",   text: "#93c5fd" },
  { name: "MongoDB",      icon: MongoIcon,       color: "rgba(16,185,129,0.15)", border: "rgba(16,185,129,0.3)",   text: "#6ee7b7" },
  { name: "MySQL",        icon: MySqlIcon,       color: "rgba(6,182,212,0.18)",  border: "rgba(6,182,212,0.32)",   text: "#67e8f9" },
  { name: "SQL Server",   icon: SqlIcon,         color: "rgba(79,70,229,0.18)",  border: "rgba(79,70,229,0.35)",   text: "#a5b4fc" },
  { name: "Visual Basic", icon: VisualIcon,      color: "rgba(139,92,246,0.18)", border: "rgba(139,92,246,0.32)",  text: "#c4b5fd" },
  { name: "Astro",        icon: AstroIcon,       color: "rgba(249,115,22,0.18)", border: "rgba(249,115,22,0.3)",   text: "#fdba74" },
  { name: "Git",           icon: GithubIcon,  color: "rgba(100,100,110,0.2)",  border: "rgba(100,100,110,0.35)", text: "#e2e8f0" },
  { name: "Jenkins",       icon: JenkinsIcon, color: "rgba(210,90,30,0.18)",   border: "rgba(210,90,30,0.35)",   text: "#fca5a5" },
  { name: "Gemini",        icon: GeminiIcon,  color: "rgba(59,130,246,0.18)",  border: "rgba(59,130,246,0.35)",  text: "#7dd3fc" },
  { name: "GitHub Copilot",icon: CopilotIcon, color: "rgba(139,92,246,0.18)",  border: "rgba(139,92,246,0.35)",  text: "#c4b5fd" },
  { name: "Claude Code",   icon: OpenAIIcon,  color: "rgba(234,179,8,0.18)",   border: "rgba(234,179,8,0.32)",   text: "#fde047" },
  { name: "OpenAI API",    icon: OpenAIIcon,  color: "rgba(255,255,255,0.06)", border: "rgba(255,255,255,0.15)", text: "#f1f5f9" },
];
---

<div class="flex flex-wrap gap-2.5">
  {knowledges.map((tag) => (
    <span
      class="knowledge-pill"
      style={`background: ${tag.color}; border-color: ${tag.border}; color: ${tag.text};`}
    >
      <tag.icon class="size-4" />
      {tag.name}
    </span>
  ))}
</div>

<style>
  .knowledge-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8rem;
    font-weight: 500;
    padding: 0.35rem 0.85rem;
    border-radius: 9999px;
    border-width: 1px;
    border-style: solid;
    transition: transform 0.2s, filter 0.2s;
  }
  .knowledge-pill:hover {
    transform: translateY(-2px) scale(1.04);
    filter: brightness(1.15);
  }
</style>
