---
import Gmail from "../icons/Gmail.astro";
import LinkedIn from "../icons/LinkedIn.astro";
import Phone from "../icons/Phone.astro";

const contacts = [
  {
    label: "LinkedIn",
    value: "alexander-ortiz-cortes",
    href: "https://cl.linkedin.com/in/alexander-ortiz-cortes-07843a16b",
    icon: LinkedIn,
    accent: "rgba(59,130,246,0.2)",
    accentBorder: "rgba(59,130,246,0.35)",
    accentText: "#93c5fd",
  },
  {
    label: "Email",
    value: "alexander.ortiz.1098@gmail.com",
    href: "mailto:alexander.ortiz.1098@gmail.com",
    icon: Gmail,
    accent: "rgba(239,68,68,0.18)",
    accentBorder: "rgba(239,68,68,0.35)",
    accentText: "#fca5a5",
  },
  {
    label: "Teléfono",
    value: "+56 9 9378 1735",
    href: "tel:+56993781735",
    icon: Phone,
    accent: "rgba(74,222,128,0.15)",
    accentBorder: "rgba(74,222,128,0.3)",
    accentText: "#86efac",
  },
];
---

<div class="contact-grid mb-16">
  {contacts.map(({ label, value, href, icon: Icon, accent, accentBorder, accentText }) => (
    <a href={href} target="_blank" rel="noopener noreferrer" class="contact-card">
      <div
        class="contact-icon"
        style={`background: ${accent}; border-color: ${accentBorder};`}
      >
        <Icon style={`color: ${accentText};`} class="size-6" />
      </div>
      <div>
        <p class="text-white/45 text-xs mb-0.5">{label}</p>
        <p class="text-white text-sm font-medium">{value}</p>
      </div>
    </a>
  ))}
</div>

<style>
  .contact-grid {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .contact-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 1rem;
    padding: 1rem 1.25rem;
    transition: background 0.2s, border-color 0.2s, transform 0.2s;
    text-decoration: none;
  }
  .contact-card:hover {
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(255, 255, 255, 0.14);
    transform: translateX(4px);
  }

  .contact-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 0.75rem;
    border-width: 1px;
    border-style: solid;
    flex-shrink: 0;
  }
</style>
